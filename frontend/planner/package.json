{
  "name": "planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron electron/main.cjs",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.cjs",
    "build:server": "cd ../../backend/planner && npm run build && npx prisma generate",
    "dist": "npm run build:server && npm run build && electron-builder",
    "dist:win": "npm run build:server && npm run build && electron-builder --win",
    "android:sync": "npx cap sync android",
    "android:build": "vite build --mode production && npx cap sync android && cd android && .\\gradlew assembleRelease",
    "android:apk": "scripts\\build-apk.bat"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "axios": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.4",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
