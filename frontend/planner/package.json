{
  "name": "planner",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "check-env": "node scripts/check-env.mjs",
    "electron": "electron electron/main.cjs",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.cjs",
    "dist:win": "npm run check-env && npm run build && electron-builder --win --publish never",
    "android:sync": "npm run check-env && npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleRelease",
    "android:bundle": "npm run android:sync && cd android && gradlew bundleRelease"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.4",
    "autoprefixer": "^10.5.0",
    "axios": "^1.17.0",
    "cross-env": "^7.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.3.5"
  },
  "description": "Планер — события, задачи, встречи и платежи",
  "author": "Planner"
}
