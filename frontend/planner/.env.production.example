# Скопируйте в .env.production и заполните. Эти значения встраиваются в сборки для RuStore и Windows.

# Адрес сервера (обязательно https), например https://planner-backend.onrender.com или https://api.moy-planer.ru
VITE_BACKEND_URL=

# Почта для вопросов по персональным данным (показывается в политике конфиденциальности)
VITE_SUPPORT_EMAIL=
