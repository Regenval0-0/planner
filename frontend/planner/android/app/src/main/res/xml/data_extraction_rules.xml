<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Не бэкапить чувствительные shared preferences (токены, localStorage) -->
        <exclude domain="sharedpref" path="."/>
        <!-- Не бэкапить WebView localStorage и cookies -->
        <exclude domain="root" path="app_webview/"/>
        <include domain="root" path="databases/"/>
        <include domain="root" path="files/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="root" path="app_webview/"/>
        <include domain="root" path="databases/"/>
        <include domain="root" path="files/"/>
    </device-transfer>
</data-extraction-rules>
