# Скопируйте этот файл в .env (только для запуска сервера на своём компьютере).

# Секрет для подписи токенов входа: случайная строка от 32 символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Локальная база SQLite (файл prisma/dev.db)
DATABASE_URL=file:./dev.db

PORT=3001
