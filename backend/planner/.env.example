# Database (Neon.tech PostgreSQL recommended)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/planner?sslmode=require"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Server port (Render sets this automatically)
PORT=3001

# Resend API Key (get from https://resend.com, free tier: 3000 emails/day)
RESEND_API_KEY="re_xxxxxxxx"

# Public app URL (update after deploying)
APP_URL="https://planner-app.onrender.com"
