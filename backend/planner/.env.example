# JWT Secret (generate a strong random string, min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Database (SQLite by default — for local/desktop use)
DATABASE_URL=file:./dev.db

# Optional: VK OAuth credentials
# 1. Go to https://vk.com/editapp?act=create
# 2. Choose "Website" type
# 3. Set redirect URI: http://localhost:3001/api/auth/vk/callback
# 4. Copy App ID and Secure key here
VK_APP_ID=your-vk-app-id
VK_APP_SECRET=your-vk-app-secret

# Optional: Resend API key for real email sending
# Get from https://resend.com (free tier: 3000 emails/day)
# RESEND_API_KEY=re_xxxxxxxx

# Optional: SMTP credentials (alternative to Resend)
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=your-email@mail.ru
# SMTP_PASS=your-app-password
