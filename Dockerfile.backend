# Production Dockerfile for planner backend
FROM node:20-alpine AS builder

WORKDIR /app
COPY backend/planner/package*.json ./
RUN npm ci --only=production

COPY backend/planner/prisma ./prisma/
COPY backend/planner/src ./src/
COPY backend/planner/tsconfig.json ./
RUN npx prisma generate --schema=prisma/schema.prod.prisma
RUN npm run build

# Production stage
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/package*.json ./

EXPOSE 3001

# Run migrations then start server
CMD npx prisma migrate deploy --schema=prisma/schema.prod.prisma && node dist/server.js
